<Window x:Class="ElsoOraWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ElsoOraWpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Első WPF alkalmazásom" HorizontalAlignment="Center" Height="60" Margin="0,15,0,0"/>
        <Grid Grid.Row="1" Margin="15,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Add meg a korod:"/>
            <TextBox x:Name="korTextBox" Grid.Column="1" Height="60"/>
        </Grid>
        <Button Grid.Row="2" Content="Küldés" HorizontalAlignment="Left" Width="300" Height="60" Margin="15,25,0,25" Click="ButtonSubmit"/>
        <TextBlock Grid.Row="3" x:Name="eredmenyText" HorizontalAlignment="Center" FontSize="25" Height="50" Text="Eredmény:"/>
    </Grid>
</Window>
